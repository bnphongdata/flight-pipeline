# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO HỆ THỐNG PIPELINE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cấu hình Data Warehouse chính (flights_db)
# ------------------------------------------------------------------------------
# Mật khẩu người dùng Data Warehouse
POSTGRES_PASSWORD=Password1234**

# Tên cơ sở dữ liệu Data Warehouse
POSTGRES_DB=dw_flights

# Tên tài khoản kết nối Data Warehouse (pipeline_user có quyền trên schema staging, raw_data, curated)
POSTGRES_USER=pipeline_user

# Tên host dịch vụ cơ sở dữ liệu trong mạng docker
POSTGRES_HOST=flights_db

# ------------------------------------------------------------------------------
# 2. Cấu hình cơ sở dữ liệu Metadata cho Airflow (airflow-postgres)
# ------------------------------------------------------------------------------
# Tên người dùng quản trị cơ sở dữ liệu Airflow
AIRFLOW_POSTGRES_USER=airflow

# Mật khẩu cơ sở dữ liệu Airflow
AIRFLOW_POSTGRES_PASSWORD=airflow

# Tên cơ sở dữ liệu metadata của Airflow
AIRFLOW_POSTGRES_DB=airflow
